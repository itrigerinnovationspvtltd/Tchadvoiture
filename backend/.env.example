# Local defaults. On Render, do not set PORT — Render provides it.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tchadvoiture
JWT_ACCESS_SECRET=replace-with-a-long-admin-secret
JWT_CLIENT_SECRET=replace-with-a-long-client-secret
SUPER_ADMIN_EMAIL=admin@tchadvoiture.local
SUPER_ADMIN_PASSWORD=Admin12345!
# Browser origins allowed to call the API. No trailing slash.
# Production: set both to the Vercel URL, for example https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173
# Optional extra origins, comma-separated. Example: https://your-app.vercel.app,http://localhost:5173
# ALLOWED_ORIGINS=
